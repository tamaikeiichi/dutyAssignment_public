{
  "name": "duty-assign-app",
  "version": "2.3.2",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "cross-env NODE_ENV=development electron .",
    "build": "cross-env NODE_ENV=production electron-builder",
    "build:py": "pyinstaller dutyAssign.spec --clean"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamaikeiichi/dutyAssignmentElectron.git"
  },
  "bugs": {
    "url": "https://github.com/tamaikeiichi/dutyAssignmentElectron/issues"
  },
  "homepage": "https://github.com/tamaikeiichi/dutyAssignmentElectron#readme",
  "devDependencies": {
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "electron": "^28.3.3",
    "electron-builder": "^26.0.12",
    "npm-run-all": "^4.1.5"
  },
  "build": {
    "appId": "com.tamai.duty-assignment-app",
    "productName": "当直表作成",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "result.html",
      "assets/**/*",
      "!node_modules/**/*",
      "node_modules/japanese-holidays/**/*",
      "node_modules/exceljs/dist/exceljs.min.js",
      "node_modules/tabulator-tables/dist/js/tabulator.min.js",
      "node_modules/tabulator-tables/dist/css/tabulator.min.css"
    ],
    "extraResources": [
      {
        "from": "dist/dutyAssign.exe",
        "to": "app/dutyAssign.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "forceCodeSigning": false,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "japanese-holidays": "^1.0.10",
    "tabulator-tables": "6.3.0"
  }
}
